# =======================================================
# PERSONAL TRACKER — FRONTEND ENVIRONMENT VARIABLES
# =======================================================
# Copy this file to .env.local for local development,
# or set these variables in your hosting provider (Vercel, Netlify, etc.)

# -------------------------------------------------------
# 1. Backend REST API URL (Required)
# -------------------------------------------------------
# Local Development:
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Production (Replace with your actual deployed backend URL, e.g. on Render/Railway):
# NEXT_PUBLIC_API_URL=https://your-backend-api.onrender.com/api

# -------------------------------------------------------
# 2. Application Defaults (Optional)
# -------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Personal Tracker"
NEXT_PUBLIC_DEFAULT_CURRENCY=INR

